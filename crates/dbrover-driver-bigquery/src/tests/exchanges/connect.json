      "response": {"kind": "bigquery#datasetList", "datasets": [{"kind": "bigquery#dataset",
        "id": "analytics:sales", "datasetReference": {"projectId": "analytics", "datasetId": "sales"},
        "location": "europe-west2"}], "nextPageToken": "sales"}
    }
  ]
