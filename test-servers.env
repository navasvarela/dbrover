# Where the servers docker-compose.yml starts are, in the variables the tests read: one line
# per compose service. A test whose variable is unset skips, so `cargo test` also works with
# no server running.
#
# Locally, after `docker compose up -d --wait`:
#   set -a; . ./test-servers.env; set +a; cargo test --workspace
# CI appends the same lines to $GITHUB_ENV on Linux (.github/workflows/ci.yml).
DBROVER_TEST_POSTGRES_URL=postgres://dbrover:dbrover@localhost:55432/dbrover
DBROVER_TEST_POSTGRES_TLS_URL=postgres://dbrover:dbrover@localhost:55443/dbrover
DBROVER_TEST_MYSQL_URL=mysql://dbrover:dbrover@localhost:55306/dbrover
DBROVER_TEST_MARIADB_URL=mysql://dbrover:dbrover@localhost:55307/dbrover
DBROVER_TEST_SQLSERVER_URL=sqlserver://sa:DbRover-Test-2026@localhost:51433/dbrover
DBROVER_TEST_CLICKHOUSE_URL=clickhouse://dbrover:dbrover@localhost:58123/dbrover
DBROVER_TEST_CLICKHOUSE_TLS_URL=clickhouse://dbrover:dbrover@localhost:58443/dbrover
DBROVER_TEST_REDIS_URL=redis://dbrover:dbrover@localhost:56379/0
DBROVER_TEST_REDIS_TLS_URL=redis://dbrover:dbrover@localhost:56443/0
DBROVER_TEST_VALKEY_URL=redis://dbrover:dbrover@localhost:56380/0
DBROVER_TEST_MONGODB_URL=mongodb://dbrover:dbrover@localhost:57017/dbrover
# HTTPS with the test authority in docker/postgres-tls/ca.crt, and plain HTTP with no user.
DBROVER_TEST_ELASTICSEARCH_URL=https://elastic:dbrover@localhost:59200
DBROVER_TEST_OPENSEARCH_URL=http://localhost:59201
# The SSH server, and the PostgreSQL service as that server reaches it on the compose network.
DBROVER_TEST_SSH_URL=ssh://dbrover:dbrover@localhost:55222
DBROVER_TEST_SSH_POSTGRES_URL=postgres://dbrover:dbrover@postgres:5432/dbrover
