-- Made-up batteries for the battery examples: each battery's name, the size of its meter's
-- smallest unit in kWh, the price zone it trades in, and its site, in DynamoDB, keyed by the
-- battery ids that energy-postgres.sql's flows use. bat-3 has no site, which the reports fill
-- in as "unknown". None of it is anyone's real data.
--
-- Make it in DbRover: PartiQL can't create a table, so create it first, keyed by battery_id,
-- with the AWS command line (or in AWS's console):
--
--   aws dynamodb create-table --table-name energy_batteries \
--     --attribute-definitions AttributeName=battery_id,AttributeType=S \
--     --key-schema AttributeName=battery_id,KeyType=HASH --billing-mode PAY_PER_REQUEST
--
-- Then add a DynamoDB data source named "batteries-dynamodb" for that account and region, open
-- this file in its console (File → Open…), and run it all.

INSERT INTO energy_batteries VALUE {'battery_id': 'bat-1', 'name': 'Harbour', 'unit': 0.001, 'zone': 'NORTH', 'metadata': {'site': 'Harbour depot', 'capacity_kwh': 2000}};
INSERT INTO energy_batteries VALUE {'battery_id': 'bat-2', 'name': 'Hillside', 'unit': 0.000001, 'zone': 'SOUTH', 'metadata': {'site': 'Hillside farm', 'capacity_kwh': 1500}};
INSERT INTO energy_batteries VALUE {'battery_id': 'bat-3', 'name': 'Riverside', 'unit': 0.000000001, 'zone': 'WEST', 'metadata': {'capacity_kwh': 3000}};
