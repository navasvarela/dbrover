-- Synthetic asset metadata for the valuation and cost basis examples: each asset's symbol, the
-- size of its smallest unit, and its chain, in DynamoDB, keyed by the asset ids that
-- valuation-postgres.sql's transactions use. SOL has no chain, which the reports fill in as
-- "unknown". None of it is anyone's real data.
--
-- Make it in DbRover: PartiQL can't create a table, so create it first, keyed by asset_id,
-- with the AWS command line (or in AWS's console):
--
--   aws dynamodb create-table --table-name valuation_assets \
--     --attribute-definitions AttributeName=asset_id,AttributeType=S \
--     --key-schema AttributeName=asset_id,KeyType=HASH --billing-mode PAY_PER_REQUEST
--
-- Then add a DynamoDB data source named "assets-dynamodb" for that account and region, open
-- this file in its console (File → Open…), and run it all.

INSERT INTO valuation_assets VALUE {'asset_id': 'btc', 'symbol': 'BTC', 'unit': 0.00000001, 'metadata': {'chain': 'bitcoin', 'decimals': 8}};
INSERT INTO valuation_assets VALUE {'asset_id': 'eth', 'symbol': 'ETH', 'unit': 0.000000000000000001, 'metadata': {'chain': 'ethereum', 'decimals': 18}};
INSERT INTO valuation_assets VALUE {'asset_id': 'sol', 'symbol': 'SOL', 'unit': 0.000000001, 'metadata': {'decimals': 9}};
